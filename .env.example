# Polymarket private key for signing orders (Polygon network)
# NEVER commit your actual private key to version control
POLYMARKET_PRIVATE_KEY=0x_your_private_key_here

# Optional: Override config values
# POLYMARKET__CLOB_URL=https://clob.polymarket.com
# STRATEGY__MIN_NET_SPREAD=0.005
# RISK__MAX_ORDER_SIZE_USDC=50.0

# Dashboard telemetry (set telemetry.enabled = true in config to use these).
# SUPABASE_URL is your project's API URL; SUPABASE_SERVICE_KEY is the
# service_role key (server-side only — NEVER ship this to the frontend).
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key_here
